# Google Sheet ID: the long id in the sheet URL (docs.google.com/spreadsheets/d/<ID>/edit)
SHEET_ID=
# From the service-account JSON key file
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Tab that receives Google Form responses
CANDIDATES_TAB=Form Responses 1
# Tabs holding questions are named Q_<Position>, e.g. Q_Accountant, Q_Sales
QUESTION_PREFIX=Q_
# Tab where finished interviews are saved
RESULTS_TAB=Interviews
# Password the interviewers type to open the portal (leave empty for no password)
APP_PASSWORD=
